{
  "name": "bb-plugin-pele",
  "version": "0.2.0",
  "description": "Render Mermaid diagrams in assistant replies with Pele, in BB's colors and fonts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dillionverma/bb-plugin-pele.git"
  },
  "homepage": "https://github.com/dillionverma/bb-plugin-pele#readme",
  "bugs": {
    "url": "https://github.com/dillionverma/bb-plugin-pele/issues"
  },
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.79"
  },
  "scripts": {
