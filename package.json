    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "dependencies": {
    "pele": "1.12.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.79",
    "@radix-ui/react-dialog": "^1.1.19",
